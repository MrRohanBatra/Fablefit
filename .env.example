# ==============================================================================
# FableFit local environment configuration
# Copy this file to .env and change values for your local PostgreSQL instance.
# Do not commit .env.
# ==============================================================================

SPRING_PROFILES_ACTIVE=local
APP_VERSION=0.1.0-SNAPSHOT

# Gateway — services/apps/gateway
GATEWAY_PORT=8080
GATEWAY_JWT_ISSUER_URI=http://localhost:8081
IDENTITY_SERVICE_URL=http://localhost:8081
COMMERCE_SERVICE_URL=http://localhost:8082

# Identity — owns only the identity schema in the shared fablefit database.
IDENTITY_PORT=8081
IDENTITY_DB_URL=jdbc:postgresql://localhost:5432/fablefit
IDENTITY_DB_USERNAME=fablefit
IDENTITY_DB_PASSWORD=change-me
IDENTITY_DB_SCHEMA=identity
IDENTITY_DDL_AUTO=update
IDENTITY_JWT_ISSUER_URI=http://localhost:8081

# Commerce — owns only the commerce schema in the shared fablefit database.
COMMERCE_PORT=8082
COMMERCE_DB_URL=jdbc:postgresql://localhost:5432/fablefit
COMMERCE_DB_USERNAME=fablefit
COMMERCE_DB_PASSWORD=change-me
COMMERCE_DB_SCHEMA=commerce
COMMERCE_DDL_AUTO=update
COMMERCE_JWT_ISSUER_URI=http://localhost:8081

